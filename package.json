{
  "name": "job-journey",
  "version": "1.0.0",
  "description": "A full-stack job application tracker built with React, Express, and MongoDB.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "setup-production": "npm ci --include=dev && npm ci --include=dev --prefix client && npm run build-client",
    "setup-project": "npm ci && npm ci --prefix client",
    "server": "node --watch server.js",
    "client": "npm run dev --prefix client",
    "build-client": "npm run build --prefix client",
    "dev": "concurrently -n 'server,client' -c 'red,green' --kill-others-on-fail \" npm run server\" \" npm run client\"",
    "test": "node --test tests/*.test.js && npm run test:run --prefix client",
    "start": "node server.js",
    "lint": "npm run lint --prefix client",
    "typecheck": "npm run typecheck --prefix client"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.5",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.4",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "resend": "^6.32.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "minimatch@3": {
      "brace-expansion": "^1.1.21"
    }
  }
}
